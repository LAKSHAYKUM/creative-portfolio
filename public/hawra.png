<svg 
  xmlns="http://www.w3.org/2000/svg" 
  viewBox="0 0 120 120" 
  className="w-12 h-12 md:w-16 md:h-16 transition-transform duration-300 hover:scale-110"
>
  <defs>
    {/* Red Gradient */}
    <linearGradient id="primaryRed" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stopColor="#ff4b4b" />
      <stop offset="100%" stopColor="#dc2626" />
    </linearGradient>
    
    {/* Neon Glow Effect */}
    <filter id="redGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="4" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>

  {/* Left Web Bracket */}
  <path 
    d="M 35 25 L 15 60 L 35 95" 
    fill="none" 
    stroke="url(#primaryRed)" 
    strokeWidth="6" 
    strokeLinecap="round" 
    strokeLinejoin="round" 
  />
  
  {/* Right Web Bracket */}
  <path 
    d="M 85 25 L 105 60 L 85 95" 
    fill="none" 
    stroke="url(#primaryRed)" 
    strokeWidth="6" 
    strokeLinecap="round" 
    strokeLinejoin="round" 
  />

  {/* Center Motion Play Button */}
  <path 
    d="M 48 42 L 72 60 L 48 78 Z" 
    fill="url(#primaryRed)" 
    filter="url(#redGlow)" 
  />
</svg>